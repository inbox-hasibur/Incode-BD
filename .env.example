# MongoDB Connection String (Atlas or Local)
# Replace <username>, <password>, and cluster URL with your actual credentials
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/incodebd?retryWrites=true&w=majority
MONGODB_DB=incodebd

# Base Site URL
NEXT_PUBLIC_SITE_URL=https://incodebd.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Form URL for Internship
NEXT_PUBLIC_INTERNSHIP_FORM_URL=https://forms.gle/dE1ivECwFbrzrLHf6
